{
  "expo": {
    "name": "Football Friends",
    "slug": "footyfriends",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "footy",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E0B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.footyfriends.app",
      "associatedDomains": [
        "applinks:footyfriends.app"
      ],
      "infoPlist": {
        "NSUserTrackingUsageDescription": "We use this to send you notifications about your matches.",
        "CFBundleLocalizations": [
          "en",
          "ro"
        ]
      }
    },
    "android": {
      "package": "com.footyfriends.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E0B"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "footyfriends.app"
            },
            {
              "scheme": "footy"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Football Friends",
      "shortName": "Footy",
      "description": "Organise your weekly 6-a-side football matches",
      "themeColor": "#0A0E0B",
      "backgroundColor": "#0A0E0B"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-localization",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}
