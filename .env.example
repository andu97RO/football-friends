# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (for seeding/admin operations - DO NOT expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
EXPO_PUBLIC_APP_SCHEME=footy
EXPO_PUBLIC_TIMEZONE=Europe/Bucharest
# Base for invite and match links shared from the phone apps (web uses its own origin)
EXPO_PUBLIC_WEB_URL=https://football-friends-seven.vercel.app
